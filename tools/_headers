# The game pieces are fetched by fingerprinted addresses (see make_site.sh); the engine's own
# files keep fixed names, so everything here is checked with the server on each visit (a cheap
# 304 when unchanged) rather than trusted from the browser's cache.
/game/*
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
